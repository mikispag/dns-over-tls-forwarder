[Unit]
Description=DNS-over-TLS forwarder
After=network.target
# Name-resolution providers order themselves before nss-lookup.target.
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
DynamicUser=yes
LimitNOFILE=32768
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/dns-over-tls-forwarder -a 127.0.0.1:53
Restart=always
RestartSec=5

# Sandboxing. DynamicUser= already implies ProtectSystem=strict,
# ProtectHome=read-only, PrivateTmp=, NoNewPrivileges=, and RestrictSUIDSGID=.
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
# AF_UNIX and AF_NETLINK serve system NSS lookups of hostname-only upstreams.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
